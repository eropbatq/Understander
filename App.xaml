<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Understander"
             xmlns:converters="clr-namespace:Understander.Converters"
             x:Class="Understander.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры для режима диалога -->
            <converters:BoolToHorizontalOptionConverter x:Key="BoolToHorizontalOptionConverter" />
            <converters:NullHasConverter x:Key="NullHasConverter" />
            <converters:CodeToNameConverter x:Key="CodeToNameConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
