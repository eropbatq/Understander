<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- ============================================================
         Understander Palette
         Каждая пара "Light/Dark" определена один раз, ниже для неё
         созданы DynamicResource-ключи со значениями AppThemeBinding,
         поэтому страницы используют только "{DynamicResource ...}".
         ============================================================ -->

    <!-- Page / surfaces: нейтральный серый фон, карточки — чуть светлее/темнее -->
    <Color x:Key="PageBgLight">#EFEFF2</Color>
    <Color x:Key="PageBgDark">#17181B</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1F2023</Color>

    <Color x:Key="SurfaceAltLight">#E3E3E8</Color>
    <Color x:Key="SurfaceAltDark">#2B2C31</Color>

    <Color x:Key="HairlineLight">#DBDBE1</Color>
    <Color x:Key="HairlineDark">#33343A</Color>

    <!-- Accent (фиолетовый из брендинга .NET MAUI, но насыщеннее) -->
    <Color x:Key="AccentLight">#5B45E0</Color>
    <Color x:Key="AccentDark">#A996FF</Color>

    <Color x:Key="AccentSoftLight">#EDE9FF</Color>
    <Color x:Key="AccentSoftDark">#2A2447</Color>

    <Color x:Key="GradientToLight">#9B6BFF</Color>
    <Color x:Key="GradientToDark">#6E5AE0</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#14162B</Color>
    <Color x:Key="TextPrimaryDark">#F2F3FA</Color>

    <Color x:Key="TextSecondaryLight">#5D6279</Color>
    <Color x:Key="TextSecondaryDark">#9CA2BC</Color>

    <Color x:Key="TextMutedLight">#8C91A8</Color>
    <Color x:Key="TextMutedDark">#6E7591</Color>

    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#16121F</Color>

    <!-- Semantic -->
    <Color x:Key="DangerLight">#E5484D</Color>
    <Color x:Key="DangerDark">#FF6369</Color>

    <Color x:Key="DangerSoftLight">#FDECEC</Color>
    <Color x:Key="DangerSoftDark">#3A1E22</Color>

    <Color x:Key="SuccessLight">#12805C</Color>
    <Color x:Key="SuccessDark">#4CD9A4</Color>

    <Color x:Key="SuccessSoftLight">#E2F7EF</Color>
    <Color x:Key="SuccessSoftDark">#15322A</Color>

    <!-- ============================================================
         Градиентные кисти для акцентных элементов (логотип, кнопки)
         ============================================================ -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D4AFF" Offset="0.0" />
        <GradientStop Color="#9B5CFF" Offset="0.55" />
        <GradientStop Color="#C86BFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D4AFF" Offset="0.0" />
        <GradientStop Color="#9B6BFF" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>


