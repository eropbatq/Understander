<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Understander.MainPage"
             xmlns:vm="clr-namespace:Understander.ViewModels"
             xmlns:services="clr-namespace:Understander.Services"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16" VerticalOptions="Start">

            <!-- Greeting -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="UNDERSTANDER" Style="{StaticResource BrandText}" />
                    <Label Text="Перевод без границ" Style="{StaticResource ScreenTitle}" />
                    <Label Text="Введите текст или сделайте снимок" Style="{StaticResource ScreenSubtitle}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource IconTileBorder}" VerticalOptions="Center">
                    <Label Text="🌐" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Language card -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="ДВИЖОК" Style="{StaticResource FieldCaption}"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="1" ItemsSource="{Binding Providers}"
                                ItemDisplayBinding="{Binding Name, x:DataType=services:ITranslator}" SelectedItem="{Binding Provider}"
                                Style="{StaticResource InlinePicker}" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="ОТ" Style="{StaticResource FieldCaption}" />
                            <Picker ItemsSource="{Binding FromLangs}" ItemDisplayBinding="{Binding Name, x:DataType=vm:Lang}"
                                    SelectedItem="{Binding From}" Style="{StaticResource InlinePicker}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="⇄" Command="{Binding SwapCommand}"
                                Style="{StaticResource IconButton}"
                                WidthRequest="40" HeightRequest="40" CornerRadius="12" FontSize="16"
                                MinimumWidthRequest="40" MinimumHeightRequest="40"
                                VerticalOptions="End" Margin="0,0,0,4" />

                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                            <Label Text="КОМУ" Style="{StaticResource FieldCaption}" />
                            <Picker ItemsSource="{Binding ToLangs}" ItemDisplayBinding="{Binding Name, x:DataType=vm:Lang}"
                                    SelectedItem="{Binding To}" Style="{StaticResource InlinePicker}"
                                    HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Input card -->
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14,16,0">
                        <Label Grid.Column="0" Text="ВАШ ТЕКСТ" Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding ClearCommand}"
                                Style="{StaticResource IconButton}"
                                WidthRequest="30" HeightRequest="30" CornerRadius="10" FontSize="12"
                                MinimumWidthRequest="30" MinimumHeightRequest="30" />
                    </Grid>
                    <Editor Placeholder="Введите текст…" Text="{Binding Input}"
                            Margin="12,8,12,12" AutoSize="TextChanges"
                            MinimumHeightRequest="110" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Text="📷" Command="{Binding PhotoCommand}"
                        Style="{StaticResource IconButton}" />
                <Button Grid.Column="1" Text="Перевести →" Command="{Binding TranslateCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="2" Text="🔊" Command="{Binding SpeakCommand}"
                        Style="{StaticResource IconButton}" />
            </Grid>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />

            <!-- Result card -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasResult}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="ПЕРЕВОД" Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                            <Label Text="{Binding Pair}" Style="{StaticResource ChipText}" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding Result}" Style="{StaticResource ResultText}"
                           MinimumHeightRequest="56" />

                    <BoxView Style="{StaticResource Divider}" />

                    <Button Text="📋 Скопировать" Command="{Binding CopyCommand}"
                            Style="{StaticResource SoftButton}" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

