<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Understander.Views.DialoguePage"
             xmlns:vm="clr-namespace:Understander.ViewModels"
             x:DataType="vm:DialogueViewModel"
             Title="Диалог"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Language bar (compact, top) -->
        <Border Grid.Row="0" Style="{StaticResource LanguageBarBorder}" Margin="16,12,16,0">
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Padding="12,8">
                <Label Grid.Column="0" Text="{Binding Person1Lang.Name}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalOptions="Center" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="⇄" VerticalOptions="Center" HorizontalOptions="Center"
                       FontSize="16" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSwapTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="2" Text="{Binding Person2Lang.Name}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalOptions="Center" HorizontalOptions="End" />
            </Grid>
        </Border>

        <!-- Messages list -->
        <CollectionView Grid.Row="1" x:Name="MessagesView" ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        Margin="16,8,16,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DialogueMessage">
                    <Border Style="{StaticResource MessageCardBorder}">
                        <VerticalStackLayout Spacing="0">

                            <!-- Language direction label -->
                            <Label Text="{Binding FromLang, Converter={StaticResource CodeToNameConverter}}"
                                   Style="{StaticResource MessageLangLabel}" />

                            <!-- Original text (large) -->
                            <Label Text="{Binding Text}" Style="{StaticResource MessageOriginalText}" />

                            <!-- Translation (large, below original) -->
                            <Label Text="{Binding TranslatedText}" Style="{StaticResource MessageTranslationText}"
                                   IsVisible="{Binding TranslatedText, Converter={StaticResource NullHasConverter}}" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="40">
                    <Label Text="💬" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Нажмите на микрофон и говорите"
                           Style="{StaticResource SecondaryText}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HeightRequest="24" WidthRequest="24"
                           HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,20"
                           Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />

        <!-- PTT button (bottom center) -->
        <Grid Grid.Row="2" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,32">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <!-- PTT Button -->
                <Button x:Name="MicButton"
                        Text="🎤"
                        Style="{StaticResource MicButton}"
                        Command="{Binding ToggleRecordingCommand}">
                    <Button.Triggers>
                        <!-- Пока идёт запись, кнопка красная -->
                        <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="BackgroundColor" Value="#E5484D" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Hint -->
                <Label Text="{Binding StatusText}"
                       Style="{StaticResource FieldCaption}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       MaximumWidthRequest="300" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
