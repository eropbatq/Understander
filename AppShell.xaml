<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Understander.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Understander"
    xmlns:views="clr-namespace:Understander.Views"
    Title="Understander">

    <TabBar>
        <Tab Title="Главная" Icon="tab_first.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="Views.MainPage" />
        </Tab>
        <Tab Title="История" Icon="tab_second.png">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" Route="Views.HistoryPage" />
        </Tab>
        <Tab Title="Режим диалога" Icon="tab_dialogue.png">
            <ShellContent ContentTemplate="{DataTemplate views:DialoguePage}" Route="Views.DialoguePage" />
        </Tab>
    </TabBar>

</Shell>
